// HOST_NEXT vaut ∅ hors bluetooth auto, sinon il sélectionne l’hôte connecté suivant.
#ifndef HOST_NEXT
#define HOST_NEXT no___
#define HOST_NEXT_LOCAL
#endif

// Keymap macOS fixe : la couche zéro reste le même OS après redémarrage.

// · : action héritée d’une couche inférieure. ∅ : aucune action.
// Dans é/É ou à/â/À, les actions suivent le nombre d’appuis. → : appui bref puis maintien.
// L1 : primaire, double appui secondaire, triple appui pavé. L2 : secondaire, double primaire.
// Les encadrés extérieurs indiquent les deux actions de rotation, dans l’ordre des bindings.
// AS : raccourcis AeroSpace. Foc/Dépl : focus, déplacement avec Shift. ⇧ : Shift, ⌥ : Option.

// Base et encodeurs.
// Paramètres OS de la base commune.
#define BASE_LAYER(bindings, sensors) LAYER(BASE, bindings, sensors)
#define BASE_CTRL &kp M_CMD
#define BASE_ALT &kp M_OPN
#define BASE_DOT &m_dot_excl
#define BASE_BSLS &m_colon_bsls
#define BASE_GUI &kp M_CTL
#define BASE_OS &mac

// ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
// ┃    ESC    ┃     A     ┃     Z     ┃     E     ┃     R     ┃     T     ┃   ┃     Y     ┃     U     ┃     I     ┃     O     ┃     P     ┃   BSPACE  ┃
// ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
