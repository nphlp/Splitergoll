// ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
// ┃           ┃           ┃ M/F to L  ┃ M/F to U  ┃ M/F to R  ┃           ┃   ┃     ´     ┃     `     ┃     ^     ┃     ¨     ┃     ~     ┃           ┃
// ┗━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┛
//             ┃           ┃           ┃ M/F to D  ┃           ┃Print Scree┃   ┃           ┃           ┃           ┃           ┃           ┃
// ╭───────╮   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ╭───────╮
// │ UP    │ ┏━━━━━━━━━━━┓ ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓ ┏━━━━━━━━━━━┓ │ LEFT  │
// │ DOWN  │ ┃           ┃ ┃           ┃           ┃           ┃           ┃   ┃   LSHIFT  ┃           ┃           ┃           ┃ ┃           ┃ │ RIGHT │
// ╰───────╯ ┗━━━━━━━━━━━┛ ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛ ┗━━━━━━━━━━━┛ ╰───────╯
    trs__       trs__       &kp F_T     &kp F_F     &kp F_A     trs__
    trs__       no___       &MF_L       &MF_U       &MF_R       no___
                no___       no___       &MF_D       no___       &kp LS(RA(_Q))
                trs__       no___       no___       trs__       no___
                                                                                trs__       &MF_1       &MF_2       &MF_3       trs__       trs__
                                                                                &kp M_AGU   &kp M_GRV   &kp M_CIR   &kp M_TRE   &kp M_TLD   no___
                                                                                no___       no___       no___       no___       no___
                                                                                &kp LSHIFT  trs__       no___       no___       &bt BT_CLR_ALL
// ┃           ┃           ┃           ┃           ┃           ┃           ┃   ┃           ┃           ┃           ┃           ┃           ┃           ┃
, &inc_dec_kp UP DOWN                                                           &inc_dec_kp LEFT RIGHT)

LAYER(NUMPAD,
