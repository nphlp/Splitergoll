# Options locales du clavier, déduites de la keymap sélectionnée.
config SPLITERGOLL_BLE_MEMORY
    bool
    depends on BT && SETTINGS && BT_SETTINGS && ZMK_SPLIT_ROLE_CENTRAL
    depends on MBEDTLS_SHA256 && BT_SMP_SC_PAIR_ONLY
    depends on !BT_SIGNING && !BT_KEYS_OVERWRITE_OLDEST

config SPLITERGOLL_OS_AUTO
    bool
    default y if DT_HAS_SPLITERGOLL_OS_AUTO_ENABLED
    depends on ZMK_SPLIT_ROLE_CENTRAL && (ZMK_USB || ZMK_BLE)

config SPLITERGOLL_BLE_AUTO
    bool
    default y if SPLITERGOLL_OS_AUTO && !ZMK_USB
    depends on ZMK_BLE && !ZMK_USB && ZMK_SPLIT_ROLE_CENTRAL
    select SPLITERGOLL_BLE_MEMORY

config SPLITERGOLL_BLE_RECONNECT
    bool
    default y if SPLITERGOLL_BLE_AUTO
    depends on SPLITERGOLL_BLE_AUTO && !BT_EXT_ADV && BT_SMP_APP_PAIRING_ACCEPT
    select BT_FILTER_ACCEPT_LIST

config SPLITERGOLL_BLE_OBSERVER
    bool
    default y if SPLITERGOLL_BLE_MEMORY
    depends on BT && ZMK_SPLIT_ROLE_CENTRAL

config SPLITERGOLL_USB_OBSERVER
    bool
    default y if (SPLITERGOLL_OS_AUTO && ZMK_USB) || SPLITERGOLL_USB_TRACE
    depends on USB_DEVICE_STACK && ZMK_SPLIT_ROLE_CENTRAL

# Le socle ZMK_BLE reste nécessaire au split, les annonces hôtes sont filtrées au lien.
config SPLITERGOLL_WIRE_USB_ONLY
    bool "USB-only host output on the wire central"
    depends on ZMK_USB && ZMK_BLE && ZMK_SPLIT_BLE && ZMK_SPLIT_ROLE_CENTRAL
    depends on !SPLITERGOLL_BLE_RECONNECT && !BT_EXT_ADV && !LTO

config SPLITERGOLL_HOST_IDENTITY
    bool "Diagnostic host identity over vendor USB HID and encrypted BLE"
    depends on SPLITERGOLL_BLE_AUTO && ZMK_SPLIT_ROLE_CENTRAL && !ZMK_USB
    depends on !USB_DEVICE_STACK_NEXT && !ZMK_USB_LOGGING && !LTO
    depends on USB_DEVICE_STACK && USB_DEVICE_HID && CSPRNG_ENABLED
