# Options des diagnostics propres à Splitergoll, désactivées dans les builds usuels.
config SPLITERGOLL_USB_TRACE
    bool "Record USB setup requests on the diagnostic serial port"
    depends on USB_DEVICE_STACK && USB_CDC_ACM
    depends on ZMK_SPLIT_ROLE_CENTRAL
    default n

config SPLITERGOLL_BLE_TRACE
    bool "Record host BLE discovery on the diagnostic serial port"
    depends on BT && USB_DEVICE_STACK && USB_CDC_ACM
    depends on ZMK_SPLIT_ROLE_CENTRAL && !ZMK_USB
    depends on !SPLITERGOLL_USB_TRACE
    select BT_REMOTE_INFO
    select SPLITERGOLL_BLE_MEMORY
    default n
